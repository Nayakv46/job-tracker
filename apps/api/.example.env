DATABASE_URL="postgresql://postgres:postgres@localhost:5434/job_tracker?schema=public"
JWT_SECRET=jwtsecret
REFRESH_SECRET=jwtrefreshsecret
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
PORT=4000
FRONTEND_URL=http://localhost:3000
# Rate limiting (requests per minute per IP)
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10
# Number of reverse proxies in front of the API (0 locally, 1 behind Ingress/ALB)
TRUST_PROXY=0
