# Optional overrides for `docker compose up` (copy to .env). All values have local defaults.
JWT_SECRET=change-me
REFRESH_SECRET=change-me-too
# Host ports, if 3000/4000 are taken (e.g. by `npm run dev`)
WEB_PORT=3000
API_PORT=4000
# API rate limits per minute (defaults 100 and 10). All requests come from the web
# container's IP, so the Playwright tests (apps/web, npm run test:e2e) need far more:
# THROTTLE_LIMIT=100000
# THROTTLE_AUTH_LIMIT=100000
